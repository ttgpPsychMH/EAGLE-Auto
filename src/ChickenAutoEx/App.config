<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Explicit codec; use UTF-8 only after confirming the private-client encoding. -->
    <add key="AcBaSystemEncoding" value="VISCII" />
    <add key="UpdateMetadataUrl" value="https://raw.githubusercontent.com/ttgpPsychMH/EAGLE-Auto/master/PatchInfoEx.ini" />
    <add key="UpdateTimeoutMilliseconds" value="5000" />
  </appSettings>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchUseStrongCrypto=false;Switch.System.Net.DontEnableSystemDefaultTlsVersions=false" />
  </runtime>
</configuration>
